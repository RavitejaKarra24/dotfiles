# macOS
.DS_Store
.AppleDouble
.LSOverride

# Secrets - NEVER commit these
zsh/.zshrc.secrets

# Application state/cache (not config)
calcure/.config/calcure/events.csv
calcure/.config/calcure/tasks.csv
calcure/.config/calcure/info.log
atuin/.config/atuin/server_id
atuin/.config/atuin/history.db
atuin/.config/atuin/history.db-*

# Zed state
zed/.config/zed/conversations/
zed/.config/zed/embeddings/
zed/.config/zed/prompts/

# Karabiner automatic backups
karabiner/.config/karabiner/automatic_backups/

# Neovim generated/cache files
nvim/.config/nvim/plugin/
nvim/.config/nvim/.luarc.json
nvim/.config/nvim/nvim.log
nvim.log
*.log

# Fish history and generated completions
fish/.config/fish/fish_history
fish/.config/fish/fish_variables
fish/.config/fish/completions/

# btop logs
btop/.config/btop/btop.log

# Spotify player cache
spotify-player/.config/spotify-player/cache/
spotify-player/.config/spotify-player/.spotify_token_cache*

# Node modules (if any sneak in)
node_modules/

# Codex — track only durable config; never auth or runtime state
codex/.codex/*
!codex/.codex/AGENTS.md
!codex/.codex/config.toml
!codex/.codex/keybindings.json
!codex/.codex/rules/
codex/.codex/rules/*
!codex/.codex/rules/default.rules
!codex/.codex/skills/
codex/.codex/skills/*
!codex/.codex/skills/skill-router/
!codex/.codex/skills/skill-router/**

# pi coding agent — runtime / secrets (never commit)
pi/.pi/agent/.env
pi/.pi/agent/auth.json
pi/.pi/agent/trust.json
pi/.pi/agent/models-store.json
pi/.pi/agent/sessions/
pi/.pi/agent/workflows/
pi/.pi/agent/bin/
pi/.pi/agent/node_modules/
pi/.pi/agent/npm/
# skill package installs (any depth under pi skills)
pi/.pi/agent/skills/**/node_modules/

# agents skills — never commit runtime junk
agents/.agents/skills/**/node_modules/

# Zed temp files
zed/.config/zed/.tmp*

# Yazi temp/backup files
yazi/.config/yazi/*.toml-*

# Locally compiled SketchyBar helper (source remains tracked)
sketchybar/.config/sketchybar/helper/helper
